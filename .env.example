# Supabase — copy this file to `.env.local` and fill in the values from
# your project: Supabase Dashboard → Project Settings → Data API / API Keys.
# The anon (publishable) key is safe to expose to the browser.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Google Gemini — server-only (NO NEXT_PUBLIC_ prefix; never expose to the browser).
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Resend — server-only. Powers the help form in the app (`/api/support`).
# The same key Supabase uses for auth email SMTP; create it at
# https://resend.com/api-keys with "Sending access".
# Without these two the form still records the message in `support_messages`,
# it just does not email anyone.
RESEND_API_KEY=re_your-resend-api-key
SUPPORT_EMAIL=where-feedback-should-land@example.com

# Optional. Must be an address at a domain verified in Resend.
SUPPORT_FROM=KitVault <noreply@kitvault.dev>
